# Refuse to run under a node the lockfile was not written by, rather
# than warning and carrying on.
#
# npm writes optional dependencies' "libc" fields from node 24 and
# strips them on older ones, so installing with the wrong node silently
# rewrites package-lock.json - 14 deletions in a file nobody edited,
# which then reappear on the next CI run. Without this, "engines" is a
# comment.
engine-strict=true
